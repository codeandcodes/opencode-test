#!/usr/bin/env python3
import sys

def parse_csv_line(line):
    """Parse a single CSV line according to RFC 4180."""
    fields = []
    current = []
    in_quotes = False
    i = 0
    
    while i < len(line):
        c = line[i]
        if in_quotes:
            if c == '"':
                if i + 1 < len(line) and line[i + 1] == '"':
                    current.append('"')
                    i += 2
                else:
                    in_quotes = False
                    i += 1
            else:
                current.append(c)
                i += 1
        else:
            if c == '"':
                in_quotes = True
                i += 1
            elif c == ',':
                fields.append(''.join(current))
                current = []
                i += 1
            else:
                current.append(c)
                i += 1
    
    fields.append(''.join(current))
    return fields

def read_csv(filename):
    """Read CSV file and return header and rows."""
    with open(filename, 'r', newline='') as f:
        content = f.read()
    
    content = content.replace('\r\n', '\n')
    lines = content.split('\n')
    
    if not lines or lines[0] == '':
        return [], []
    
    header = parse_csv_line(lines[0])
    rows = []
    for line in lines[1:]:
        if line:
            rows.append(parse_csv_line(line))
    
    return header, rows

def format_field(field):
    """Format a field for output with proper quoting."""
    if ',' in field or '"' in field:
        return '"' + field.replace('"', '""') + '"'
    return field

def format_row(row):
    """Format a row for output."""
    return ','.join(format_field(f) for f in row)

def select(header, rows, col_names):
    """Select specific columns."""
    indices = []
    for col in col_names:
        if col not in header:
            print(f"Error: unknown column '{col}'", file=sys.stderr)
            sys.exit(1)
        indices.append(header.index(col))
    
    new_header = [header[i] for i in indices]
    new_rows = [[row[i] for i in indices] for row in rows]
    
    print(','.join(format_field(f) for f in new_header))
    for row in new_rows:
        print(','.join(format_field(f) for f in row))

def filter_rows(header, rows, col, value):
    """Filter rows where column equals value."""
    if col not in header:
        print(f"Error: unknown column '{col}'", file=sys.stderr)
        sys.exit(1)
    
    idx = header.index(col)
    
    print(','.join(format_field(f) for f in header))
    for row in rows:
        if row[idx] == value:
            print(','.join(format_field(f) for f in row))

def join_csv(header1, rows1, header2, rows2, col):
    """Inner join two CSV files on a column."""
    if col not in header1:
        print(f"Error: unknown column '{col}' in first file", file=sys.stderr)
        sys.exit(1)
    if col not in header2:
        print(f"Error: unknown column '{col}' in second file", file=sys.stderr)
        sys.exit(1)
    
    idx1 = header1.index(col)
    idx2 = header2.index(col)
    
    new_header = header1 + [h for h in header2 if h != col]
    print(','.join(format_field(f) for f in new_header))
    
    for row1 in rows1:
        key = row1[idx1]
        for row2 in rows2:
            if row2[idx2] == key:
                new_row = row1 + [f for i, f in enumerate(row2) if i != idx2]
                print(','.join(format_field(f) for f in new_row))

def agg_csv(header, rows, func, col, by_col=None):
    """Aggregate CSV data."""
    if col not in header:
        print(f"Error: unknown column '{col}'", file=sys.stderr)
        sys.exit(1)
    
    idx = header.index(col)
    
    if by_col:
        if by_col not in header:
            print(f"Error: unknown column '{by_col}'", file=sys.stderr)
            sys.exit(1)
        by_idx = header.index(by_col)
    
    values_by_key = {}
    for row in rows:
        val_str = row[idx]
        try:
            val = float(val_str)
        except ValueError:
            print(f"Error: non-numeric value '{val_str}' for aggregation", file=sys.stderr)
            sys.exit(1)
        
        if by_col:
            key = row[by_idx]
            if key not in values_by_key:
                values_by_key[key] = []
            values_by_key[key].append(val)
        else:
            if 'total' not in values_by_key:
                values_by_key['total'] = []
            values_by_key['total'].append(val)
    
    if func == 'sum':
        if by_col:
            for key in sorted(values_by_key.keys()):
                total = sum(values_by_key[key])
                print(f"{format_field(key)},{total:.2f}")
        else:
            total = sum(values_by_key['total'])
            print(f"{total:.2f}")
    elif func == 'avg':
        if by_col:
            for key in sorted(values_by_key.keys()):
                vals = values_by_key[key]
                avg = sum(vals) / len(vals)
                print(f"{format_field(key)},{avg:.2f}")
        else:
            vals = values_by_key['total']
            avg = sum(vals) / len(vals)
            print(f"{avg:.2f}")
    elif func == 'count':
        if by_col:
            for key in sorted(values_by_key.keys()):
                count = len(values_by_key[key])
                print(f"{format_field(key)},{count}")
        else:
            count = len(values_by_key['total'])
            print(f"{count}")

def parse_select_args(args):
    """Parse select arguments: COL1,COL2 FILE"""
    if len(args) < 2:
        print("Error: select requires COLS and FILE", file=sys.stderr)
        sys.exit(1)
    col_str = args[0]
    filename = args[1]
    cols = col_str.split(',')
    return cols, filename

def parse_filter_args(args):
    """Parse filter arguments: 'COL=VALUE' FILE"""
    if len(args) < 2:
        print("Error: filter requires COL=VALUE and FILE", file=sys.stderr)
        sys.exit(1)
    cond = args[0]
    filename = args[1]
    eq_idx = cond.index('=')
    col = cond[:eq_idx]
    value = cond[eq_idx + 1:]
    return col, value, filename

def parse_join_args(args):
    """Parse join arguments: FILE2 on COL FILE1"""
    if len(args) < 4 or args[1] != 'on':
        print("Error: join requires FILE2 on COL FILE1", file=sys.stderr)
        sys.exit(1)
    file2 = args[0]
    col = args[2]
    file1 = args[3]
    return file2, col, file1

def parse_agg_args(args):
    """Parse agg arguments: sum|avg|count COL FILE [--by KEYCOL]"""
    if len(args) < 3:
        print("Error: agg requires FUNC COL FILE", file=sys.stderr)
        sys.exit(1)
    
    func = args[0]
    if func not in ('sum', 'avg', 'count'):
        print(f"Error: unknown aggregation function '{func}'", file=sys.stderr)
        sys.exit(1)
    
    col = args[1]
    by_col = None
    filename = None
    
    i = 2
    while i < len(args):
        if args[i] == '--by':
            if i + 1 >= len(args):
                print("Error: --by requires a column name", file=sys.stderr)
                sys.exit(1)
            by_col = args[i + 1]
            i += 2
        else:
            if filename is None:
                filename = args[i]
            i += 1
    
    if filename is None:
        print("Error: FILE is required", file=sys.stderr)
        sys.exit(1)
    
    return func, col, filename, by_col

def main():
    if len(sys.argv) < 2:
        print("Error: no subcommand specified", file=sys.stderr)
        sys.exit(1)
    
    subcmd = sys.argv[1]
    args = sys.argv[2:]
    
    if subcmd == 'select':
        cols, filename = parse_select_args(args)
        header, rows = read_csv(filename)
        select(header, rows, cols)
    elif subcmd == 'filter':
        col, value, filename = parse_filter_args(args)
        header, rows = read_csv(filename)
        filter_rows(header, rows, col, value)
    elif subcmd == 'join':
        file2, col, file1 = parse_join_args(args)
        header1, rows1 = read_csv(file1)
        header2, rows2 = read_csv(file2)
        join_csv(header1, rows1, header2, rows2, col)
    elif subcmd == 'agg':
        func, col, filename, by_col = parse_agg_args(args)
        header, rows = read_csv(filename)
        agg_csv(header, rows, func, col, by_col)
    else:
        print(f"Error: unknown subcommand '{subcmd}'", file=sys.stderr)
        sys.exit(1)

if __name__ == '__main__':
    main()
